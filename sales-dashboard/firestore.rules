rules_version = '2';

// Firestore Security Rules for the Pulse sales dashboard demo.
//
// This is intentionally permissive since it's a public portfolio demo
// with no auth layer: anyone can read (to view the dashboard) and
// anyone can add a transaction (the "Add a new sale" button). Writes
// are restricted to only the fields/shape we expect, and updates/
// deletes are blocked entirely so visitors can't tamper with existing
// data.
//
// If you add Firebase Auth later, tighten `allow create` to
// `request.auth != null` so only signed-in users can add sales.

service cloud.firestore {
  match /databases/{database}/documents {

    match /products/{productId} {
      allow read: if true;
      allow write: if false; // seeded via Admin SDK only
    }

    match /regions/{regionId} {
      allow read: if true;
      allow write: if false; // seeded via Admin SDK only
    }

    match /customers/{customerId} {
      allow read: if true;
      allow write: if false; // seeded via Admin SDK only
    }

    match /transactions/{transactionId} {
      allow read: if true;

      allow create: if request.resource.data.keys().hasAll(
                        ['productId', 'customerId', 'regionId', 'quantity',
                         'amount', 'profit', 'date', 'status']
                      )
                      && request.resource.data.quantity is int
                      && request.resource.data.quantity > 0
                      && request.resource.data.quantity <= 10
                      && request.resource.data.amount is number
                      && request.resource.data.amount > 0
                      && request.resource.data.amount <= 5000
                      && request.resource.data.status in ['completed', 'refunded'];

      allow update: if false;
      allow delete: if false;
    }
  }
}
